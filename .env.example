# Copia este archivo como .env y completa tus API keys. El archivo .env NUNCA se sube al repositorio.
#   Linux / macOS / Git Bash:  cp .env.example .env
#   PowerShell (Windows):      copy .env.example .env
# Ningun nombre de modelo, indice o namespace esta escrito en el codigo: todo se define aca.

# --- LLM ---
# Proveedor de LLM: anthropic u openai
LLM_PROVIDER=anthropic
# API key del proveedor elegido (completa solo la que uses)
ANTHROPIC_API_KEY=tu_api_key_aqui
OPENAI_API_KEY=tu_api_key_aqui
# Modelo de chat (obligatorio, sin valor por defecto en el codigo). Ejemplos: claude-haiku-4-5-20251001 (anthropic) o gpt-4o-mini (openai)
LLM_MODEL=claude-haiku-4-5-20251001

# --- Pinecone (indice vectorial + embeddings) ---
PINECONE_API_KEY=tu_api_key_aqui
# Nombre del indice (si no existe, la ingesta lo crea) y namespace donde viven las politicas
PINECONE_INDEX_NAME=intelligence-system
PINECONE_NAMESPACE=politicas-flomat
# Nube y region donde se crea el indice serverless (solo se usan si hay que crearlo)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Modelo de embeddings de Pinecone Inference y su dimension (el indice se crea con esta dimension; multilingual-e5-large = 1024)
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIM=1024

# --- RAG ---
# Carpeta con los PDF de las politicas
DATA_DIR=data
# Fragmentos que devuelve cada busqueda y constante k de la fusion RRF (60 es el valor estandar)
TOP_K=4
RRF_K=60
# Tamano maximo (caracteres) de un fragmento y solape cuando una seccion hay que partirla (el solape debe ser menor que el tamano)
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Redis ---
# Estado de los trabajos, cola y checkpoints de LangGraph. Necesita Redis Stack (lo trae docker-compose.yml)
# Con docker compose los contenedores usan redis://redis:6379 automaticamente; este valor es para correr sin Docker
REDIS_URL=redis://localhost:6379

# --- Workers ---
# Workers que levanta la propia API (0 = los workers corren aparte con: python -m app.worker)
WORKERS_EMBEBIDOS=2
# Trabajos que procesa en paralelo cada proceso worker
WORKER_CONCURRENCIA=5
# Tiempo maximo de un trabajo en segundos: al superarlo pasa a FAILED
JOB_TIMEOUT_SEGUNDOS=300
# Cuanto viven en Redis el estado de un trabajo y sus checkpoints (segundos)
JOB_TTL_SEGUNDOS=86400

# --- Observabilidad (Arize Phoenix) ---
# Endpoint al que se envian las trazas. Vacio = observabilidad desactivada
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Nombre del proyecto en Phoenix
PHOENIX_PROJECT_NAME=intelligence-system

# --- Orquestador ---
# Tope de pasos del grafo por invocacion; debe ser como minimo 3 x MAX_PASOS_SUPERVISOR
RECURSION_LIMIT=40
# Tope de decisiones del supervisor: al superarlo se fuerza la sintesis con lo que haya
MAX_PASOS_SUPERVISOR=8
# Veces que un especialista puede repetir su trabajo para corregir un error de validacion
MAX_REFINAMIENTOS=1
# Tope de pasos del ciclo ReAct interno de cada especialista
LIMITE_ITERACIONES_AGENTE=8
